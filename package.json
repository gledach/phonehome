{
  "name": "phonehome",
  "version": "0.1.0",
  "private": false,
  "description": "See what your devices talk to. A local DNS resolver that records which domains every device on your network contacts, classifies them, and tells you when one starts talking to somewhere new. Zero dependencies, nothing leaves the machine.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "phonehome": "./bin/phonehome.mjs"
  },
  "scripts": {
    "help": "node bin/phonehome.mjs help",
    "watch": "node bin/phonehome.mjs watch",
    "report": "node bin/phonehome.mjs report",
    "devices": "node bin/phonehome.mjs devices",
    "new": "node bin/phonehome.mjs new",
    "import": "node bin/phonehome.mjs import",
    "doctor": "node bin/phonehome.mjs doctor",
    "mcp": "node mcp-server.mjs",
    "test": "node test/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gledach/phonehome.git"
  },
  "bugs": {
    "url": "https://github.com/gledach/phonehome/issues"
  },
  "homepage": "https://github.com/gledach/phonehome#readme",
  "keywords": [
    "dns",
    "privacy",
    "telemetry",
    "network",
    "iot",
    "resolver",
    "mcp",
    "cli"
  ]
}
